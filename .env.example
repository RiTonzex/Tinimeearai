# ==============================================================================
# Tinimeearai (ที่นี่มีอะไร) - Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-super-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://127.0.0.1:8000,http://localhost:8000

# Database Configuration (Leave empty to use local SQLite, or provide PostgreSQL/Neon/Supabase URL)
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/tinimeearai?sslmode=require

# Cloudinary Media Storage (Required for persistent image uploads on Vercel)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth 2.0 (Optional - for Google Sign-In)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Email / SMTP Configuration (สำหรับส่งรหัส OTP ลืมรหัสผ่านไปยังอีเมลจริง)
# สำหรับ Gmail: เข้า myaccount.google.com -> Security -> 2-Step Verification -> App Passwords -> สร้างรหัส 16 หลัก
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_digit_gmail_app_password
# DEFAULT_FROM_EMAIL=Tinimeearai <your_email@gmail.com>

# Security Settings (Set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False


